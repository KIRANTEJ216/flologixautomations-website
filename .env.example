# Canonical origin. Defaults to https://www.flologixautomations.com (www is canonical; the apex redirects).
# Must match the live domain, and public/robots.txt must agree.
SITE_URL=https://www.flologixautomations.com

# Firestore — FLA Blog
# Firebase console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=fla-blog
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@fla-blog.iam.gserviceaccount.com
# MUST be stored with escaped \n — a literal newline is rejected by credential.cert()
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Shared secret for POST /api/blog/webhook (called by n8n)
# Generate: openssl rand -hex 32
N8N_BLOG_API_KEY=

# Contact form webhook (existing)
N8N_WEBHOOK_URL=
